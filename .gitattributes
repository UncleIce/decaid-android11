# Keep shell scripts LF on Linux CI runners.
# Without this, Windows CRLF causes: bad interpreter: /usr/bin/env bash^M
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.dart          text eol=lf
*.kts           text eol=lf
*.gradle        text eol=lf
gradlew         text eol=lf
*.apk           binary
*.jks           binary
*.keystore      binary
